#!/usr/bin/env bash
#
# aihw-starter pre-commit hook
# 目的：在提交进入公开仓库前，拦截"内部黑话 / 客户名 / 敏感金额数字"。
# 检查范围：仅暂存区(--cached)中新增或修改的行(+ 开头)，且只覆盖文本文件。
# 跳过方式：git commit --no-verify  （请勿默认使用，仅在你确认无误时启用）

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

# 仅检查 staged 的文本文件（兼容 macOS 自带 bash 3.2，不用 mapfile）
FILES=()
while IFS= read -r line; do
  [ -n "$line" ] && FILES+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.md' '*.markdown' '*.html' '*.txt' '*.yml' '*.yaml' '*.json' 2>/dev/null || true)

if [ ${#FILES[@]} -eq 0 ]; then
  exit 0
fi

VIOLATIONS=0
REPORT=""

add_violation() {
  local rule="$1"
  local file="$2"
  local lineinfo="$3"
  REPORT+="\n${RED}✗${NC} [${rule}] ${file}\n${lineinfo}\n"
  VIOLATIONS=$((VIOLATIONS+1))
}

check_pattern() {
  local rule="$1"
  local pattern="$2"
  local file="$3"
  # 只看新增行 (+开头但排除 +++ 文件头)，截掉前导 +
  local hits
  hits=$(git diff --cached -U0 -- "$file" | grep -E '^\+[^+]' | grep -nE "$pattern" || true)
  if [ -n "$hits" ]; then
    add_violation "$rule" "$file" "$(echo "$hits" | sed 's/^/    /')"
  fi
}

for f in "${FILES[@]}"; do
  # 跳过 hook 自身与 CHANGELOG（CHANGELOG 里允许出现历史用语）
  case "$f" in
    .githooks/*|CHANGELOG.md) continue ;;
  esac

  # 规则 1：内部黑话第一/第二人称
  # 注：项目内部文档（CONTRIBUTING / docs/README）允许"你/我们"，故此规则仅对 solutions/、awesome/ 与根 README 生效
  case "$f" in
    solutions/*|awesome/*|README.md)
      check_pattern "内部黑话(我们/你/咱们)" '(^|[^A-Za-z0-9])(我们|你|咱们|咱)([^A-Za-z0-9]|$)' "$f"
      ;;
  esac

  # 规则 2：内部销售用词（仅 solutions / awesome / future / 根 README）
  case "$f" in
    solutions/*|awesome/*|README.md)
      check_pattern "内部销售口径(转化率/留存率具体数字)" '(转化率|留存率|续费率|复购率)[^。\n]{0,20}[0-9]+(\.[0-9]+)?%' "$f"
      ;;
  esac

  # 规则 3：金额（万/亿元 + 具体数字），公开仓库不放营收/合同金额
  case "$f" in
    solutions/*|awesome/*|README.md)
      check_pattern "敏感金额(具体万/亿元数字)" '[0-9]+(\.[0-9]+)?\s*(万元|亿元|万人民币|亿人民币)' "$f"
      ;;
  esac

  # 规则 4：API Key / Token / Secret 形态
  check_pattern "疑似密钥(sk-/AKID/Bearer)" '(sk-[A-Za-z0-9_-]{16,}|AKID[A-Za-z0-9]{12,}|Bearer\s+[A-Za-z0-9_\.-]{20,})' "$f"

  # 规则 5：内部域名 / 工具名（不应出现在公开仓库）
  check_pattern "内部系统名(aone/odps/fbi/dingtalk内部node)" '(aone\.alibaba|odps\.aliyun|alibaba-inc\.com|alidocs\.dingtalk\.com/i/nodes)' "$f"
done

if [ $VIOLATIONS -gt 0 ]; then
  echo -e "${RED}✗ pre-commit 拦截到 ${VIOLATIONS} 处潜在问题${NC}"
  echo -e "${REPORT}"
  echo -e "${YELLOW}处理建议${NC}："
  echo "  1) 改写措辞 / 移除敏感数字后重新 git add 再提交"
  echo "  2) 如果是误报且你确认安全，可用 git commit --no-verify 跳过（请慎用）"
  exit 1
fi

echo -e "${GREEN}✓ pre-commit 通过${NC}"
exit 0
