# ============================================================
# Qwen-Omni-Realtime 环境变量模板
# 复制此文件为 .env 并填入真实值
# ============================================================

# ---- 必填 ----
DASHSCOPE_API_KEY=<在此填入百炼 API Key>
DASHSCOPE_WORKSPACE_ID=<在此填入百炼 Workspace ID>

# ---- 可选（有默认值） ----

# 地域，目前仅支持 cn-beijing
DASHSCOPE_REGION=cn-beijing

# 模型标识：qwen3.5-omni-plus-realtime / qwen3.5-omni-flash-realtime / qwen3-omni-flash-realtime
OMNI_REALTIME_MODEL=qwen3.5-omni-plus-realtime

# 音色 ID（克隆音色或内置音色标识）
OMNI_VOICE=

# 单会话音频轮次上限（plus 上限 100，建议预留 buffer 设 90）
MAX_AUDIO_TURNS=90

# 单会话最大秒数（平台硬限 120 分钟 = 7200s，建议 110 分钟留裕度）
MAX_SESSION_SECONDS=6600

# 日志级别
LOG_LEVEL=INFO

# ============================================================
# Python 依赖（等同 requirements.txt）：
#   websockets>=15.0.1
#   python-dotenv>=1.1.0
#
# 安装：pip install websockets python-dotenv
# ============================================================
