# 复制为 .env 后填入自己的 key
# 千问 / 百炼 DashScope 通用 API Key
DASHSCOPE_API_KEY=sk-your-key-here

# OpenAI 兼容端点（可选，通常不用改）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 业务空间 ID（realtime / 多模态套件脚本需要）
# 在百炼控制台 → 业务空间 → 空间详情中获取
DASHSCOPE_WORKSPACE_ID=your-workspace-id

# 多模态交互应用 ID（仅方案4 多模态套件脚本需要）
# 在百炼控制台 → 我的应用 中创建多模态交互应用后获取
DASHSCOPE_APP_ID=mm_your-app-id
